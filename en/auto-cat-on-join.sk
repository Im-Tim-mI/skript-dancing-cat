# ============================================
# Auto Cat on Join
# Runs /dancingcat automatically once a player has joined and finished loading.
# Kept separate from dancing-cat.sk so it can be enabled or disabled on its own.
# ============================================

on join:
    set {_p} to player
    wait 3 seconds
    if {_p} is online:
        make {_p} execute command "/dancingcat"
